generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // No `url` here — Prisma 7 removed it from schema.prisma. The CLI's own
  // connection (db push / migrate / introspect) is configured in
  // prisma.config.ts instead. The app's runtime client reads the same
  // DATABASE_URL (a Neon connection string) via @prisma/adapter-neon (see
  // lib/withPrisma.ts).
}

/// Le TPE encaisse la carte séparément de l'app (pas d'intégration Clover en
/// v1) — CARD ne fait qu'enregistrer que l'employé a confirmé l'encaissement.
enum PaymentMethod {
  CASH
  CARD
}

/// N'est plus un compte de connexion (voir lib/auth/superuserCode.ts pour le
/// seul secret restant, un code superuser unique partagé) : Employee sert
/// uniquement à attribuer une vente à la personne qui l'a faite, choisie
/// dans une liste à la caisse sans code. Catalogue superviseur comme
/// Artist/Commission/Category.
model Employee {
  id             String   @id @default(cuid())
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  /// Soft-disable plutôt que suppression, pour que les Sale historiques
  /// gardent une référence employé valide.
  active         Boolean  @default(true)
  sortOrder      Int      @default(0) @map("sort_order")
  /// Taux de commission vendeur (%), calculé sur le sous-total avant taxes
  /// de chaque vente qu'il enregistre (voir Sale.employeeCommissionAmount).
  /// Distinct de Commission (provenance de l'œuvre) : celle-ci ne réduit en
  /// rien le calcul de celle-là, les deux coexistent sans interaction.
  commissionRate Decimal  @default(10) @map("commission_rate") @db.Decimal(5, 2)
  /// Identifiant de l'employé correspondant dans clockin (app d'horaire),
  /// pour importer/resynchroniser sans dupliquer (voir lib/clockin.ts).
  /// Nul pour un employé ajouté manuellement plutôt qu'importé.
  externalId     String?  @unique @map("external_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sales Sale[]

  @@map("employees")
}

/// Catalogue superviseur des artistes de la galerie. N'a plus de taux de
/// commission propre : voir Commission, choisie par l'employé à chaque
/// ligne de vente selon la provenance de l'œuvre plutôt que déduite de
/// l'artiste.
model Artist {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  articles Article[]

  @@map("artists")
}

/// Catalogue superviseur des provenances (« où l'œuvre a été trouvée ») et du
/// taux de commission qui leur est associé. La commission d'une vente ne
/// dépend plus de l'artiste mais de la provenance choisie par l'employé pour
/// chaque ligne : ce taux n'est jamais exposé côté caisse, seul le titre
/// l'est (voir app/api/commissions/route.ts).
model Commission {
  id        String   @id @default(cuid())
  title     String
  rate      Decimal  @db.Decimal(5, 2)
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  saleItems SaleItem[]

  @@map("commissions")
}

/// Catalogue superviseur des catégories d'articles (original, print,
/// stickers, t-shirt...), modifiable par le superuser contrairement à
/// l'ancien enum ArticleType qu'il remplace. Sert à filtrer/rechercher plus
/// rapidement dans le catalogue et à la caisse.
model Category {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  articles Article[]

  @@map("categories")
}

/// Catalogue superviseur des articles en vente (œuvre originale, print...).
/// Prix en Decimal (jamais Float) pour éviter les erreurs d'arrondi sur de
/// l'argent.
model Article {
  id        String   @id @default(cuid())
  title     String
  price     Decimal  @db.Decimal(10, 2)
  /// URL Vercel Blob de la photo de l'article (même mécanisme que artur pour
  /// les médias uploadés). Nullable : un article peut ne pas avoir de photo.
  imageUrl  String?  @map("image_url")
  /// Faux pour un article exempté de taxes (rare, mais prévu par les notes
  /// métier). Vrai par défaut : la majorité des articles sont taxables.
  taxable   Boolean  @default(true)
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Optionnel : un article peut ne pas (encore) avoir d'artiste assigné,
  /// et supprimer un artiste ne doit pas empêcher de garder son catalogue.
  artistId String? @map("artist_id")
  artist   Artist? @relation(fields: [artistId], references: [id], onDelete: SetNull)

  /// Optionnel pour la même raison que artistId : supprimer une catégorie ne
  /// doit pas empêcher de garder l'article au catalogue.
  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  saleItems SaleItem[]

  @@map("articles")
}

/// Une transaction complète (une ou plusieurs lignes). Les montants sont
/// recalculés côté serveur à partir des Article/Artist actuels au moment de
/// la création — jamais depuis les valeurs envoyées par le client.
model Sale {
  id                       String        @id @default(cuid())
  employeeId               String        @map("employee_id")
  employee                 Employee      @relation(fields: [employeeId], references: [id])
  paymentMethod            PaymentMethod @map("payment_method")
  subtotal                 Decimal       @db.Decimal(10, 2)
  gstAmount                Decimal       @map("gst_amount") @db.Decimal(10, 2)
  qstAmount                Decimal       @map("qst_amount") @db.Decimal(10, 2)
  /// subtotal + gstAmount + qstAmount, dénormalisé pour éviter de le
  /// recalculer à chaque affichage de l'historique des ventes.
  total                    Decimal       @db.Decimal(10, 2)
  /// Figés au moment de la vente à partir de Employee.commissionRate, comme
  /// le taux/montant de Commission sur SaleItem : un changement de taux
  /// plus tard ne doit jamais changer rétroactivement une vente passée.
  employeeCommissionRate   Decimal       @map("employee_commission_rate") @db.Decimal(5, 2)
  employeeCommissionAmount Decimal       @map("employee_commission_amount") @db.Decimal(10, 2)
  requiresDelivery         Boolean       @default(false) @map("requires_delivery")
  deliveryNote             String?       @map("delivery_note") @db.Text
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")

  items SaleItem[]

  @@index([createdAt])
  @@index([employeeId])
  @@map("sales")
}

/// Une ligne de vente. Tout ce qui vient de Article/Artist/Commission est
/// dupliqué ici au moment de la vente (titre, prix, artiste, provenance,
/// taux et montant de commission) : un prix ou un taux modifié plus tard ne
/// doit jamais changer rétroactivement une vente déjà enregistrée.
model SaleItem {
  id     String @id @default(cuid())
  saleId String @map("sale_id")
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  /// Optionnel : garder la ligne même si l'article catalogue est supprimé
  /// plus tard.
  articleId    String?  @map("article_id")
  article      Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  articleTitle String   @map("article_title")
  unitPrice    Decimal  @map("unit_price") @db.Decimal(10, 2)
  quantity     Int      @default(1)

  artistId   String? @map("artist_id")
  artistName String? @map("artist_name")

  /// Provenance choisie par l'employé à la vente, obligatoire dès que la
  /// ligne a un artiste (voir app/api/sales/route.ts) ; jamais requise sinon.
  /// Optionnelle en base malgré tout : un article catalogue supprimé plus
  /// tard ne doit pas invalider la ligne historique.
  commissionId     String?     @map("commission_id")
  commission       Commission? @relation(fields: [commissionId], references: [id], onDelete: SetNull)
  commissionTitle  String?     @map("commission_title")
  commissionRate   Decimal?    @map("commission_rate") @db.Decimal(5, 2)
  commissionAmount Decimal?    @map("commission_amount") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([saleId])
  @@index([artistId])
  @@map("sale_items")
}
